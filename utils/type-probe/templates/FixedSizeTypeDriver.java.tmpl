package io.questdb.cairo;

${IMPORTS}/**
 * The type driver of ${NAME}: its facts, as its facts file declares them, and the six answers that
 * are code. utils/type-probe wrote it from the facts file; each answer below the facts is a name
 * javac reports until the author writes the answer in its place (utils/type-probe/README.md, "The
 * type driver").
 */
public final class ${CLASS} extends FixedSizeTypeDriver {
    public static final ${CLASS} INSTANCE = new ${CLASS}();

    private ${CLASS}() {
        super(
                new TypeFacts(
                        ${TAG},
                        ${MOVEMENT},
                        ${ARITHMETIC},
                        ${ACCESSOR},
                        ${NULL_POLICY},
                        ${WIRE_KIND},
                        ${RELATION_KIND},
                        ${RELATION_BITS},
                        ${IMPLICIT_CASTS},
                        ${PG_OID},
                        ${SIGNATURE_CHAR},
                        ${PG_ARRAY_OID},
                        ${NULL_WORD},
                        ${CAST_TARGET},
                        "${NAME}"
                ),
                // (service, index, columnType, position) -> defines a bind variable of the type
                defineBindVariable,
                // columnType -> the type's NULL constant
                nullConstant,
                // columnType -> the type constant of the bare tag, or null
                typeConstant,
                // (columnIndex, columnType) -> the column function that reads the type
                columnFunction,
                // (dataMem, auxMem) -> the Runnable that appends one NULL row
                nullAppender,
                // (addr, count) -> fills count values with the type's NULL
                setNull
        );
    }
}
