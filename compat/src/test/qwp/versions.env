# shellcheck shell=bash
# shellcheck disable=SC2034  # Variables are consumed by the sourcing runner.

# Last released client and server without the schema extension. Keep these
# fixed until QuestDB's supported-version policy deliberately changes; do not
# turn them into moving "latest" lookups or the legacy fallback stops being
# tested after the extension ships.
