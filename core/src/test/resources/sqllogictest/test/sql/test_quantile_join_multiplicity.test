# name: test/sql/test_quantile_join_multiplicity.test
# description: Percentile aggregates see every row that a join produces
# group: [aggregates]
#
# Ported from DuckDB test/issues/general/test_24806.test. DuckDB's median is
# quantile_cont(x, 0.5); QuestDB has no mad() or list() aggregate, so those
# columns are left out. The DOUBLE[] and window columns are additions; their
# expected values come from DuckDB.

statement ok
CREATE TABLE issue_24806 (i INT, g INT, d INT, txt INT, chr INT);

statement ok
INSERT INTO issue_24806 VALUES
    (1, 1, 1, 1, 0),
    (1, 1, 1, 1, 0),
    (42, 1, 2, 3, 9),
    (42, 1, 1, 2, 2),
    (NULL, -7, 1, 0, 0),
    (42, NULL, 3, NULL, 3);

# The original issue reproducer
query IR rowsort
SELECT t1.g, quantile_cont(t3.i, 0.5)
FROM issue_24806 t1
JOIN issue_24806 t2 ON t1.d = t2.d
JOIN issue_24806 t3 ON t2.txt = t3.chr
GROUP BY t1.g
----
-7 1.000000
1 1.000000

query IIRR rowsort
SELECT t1.g, percentile_disc(t3.i, 0.5), percentile_cont(t3.i, ARRAY[0.25, 0.5, 0.75]), percentile_disc(t3.i, ARRAY[0.25, 0.5, 0.75])
FROM issue_24806 t1
JOIN issue_24806 t2 ON t1.d = t2.d
JOIN issue_24806 t3 ON t2.txt = t3.chr
GROUP BY t1.g
----
-7 1 {1.000000,1.000000,21.500000} {1.000000,1.000000,42.000000}
1 1 {1.000000,1.000000,42.000000} {1.000000,1.000000,42.000000}

# A two-table reduction
statement ok
CREATE TABLE issue_24806_multiplicity (k INT, g INT);

statement ok
INSERT INTO issue_24806_multiplicity VALUES (1, 1), (1, 1), (1, 1), (2, 1), (2, 1);

statement ok
CREATE TABLE issue_24806_values (k INT, v INT);

statement ok
INSERT INTO issue_24806_values VALUES (1, 1), (1, 1), (2, 42), (2, 42);

query IRRI
SELECT m.g, quantile_cont(v.v, 0.5), percentile_cont(v.v, 0.5), percentile_disc(v.v, 0.5)
FROM issue_24806_multiplicity m
JOIN issue_24806_values v ON m.k = v.k
GROUP BY m.g
----
1 1.000000 1.000000 1

query IRR
SELECT m.g, quantile_cont(v.v, ARRAY[0.25, 0.5, 0.6, 0.75]), quantile_disc(v.v, ARRAY[0.25, 0.5, 0.6, 0.75])
FROM issue_24806_multiplicity m
JOIN issue_24806_values v ON m.k = v.k
GROUP BY m.g
----
1 {1.000000,1.000000,17.400000,42.000000} {1.000000,1.000000,1.000000,42.000000}

query IRR
SELECT count(*), min(c), max(c)
FROM (
    SELECT percentile_cont(v.v, 0.6) OVER (PARTITION BY m.g) c
    FROM issue_24806_multiplicity m
    JOIN issue_24806_values v ON m.k = v.k
)
----
10 17.400000 17.400000
