# ==== designated TIMESTAMP next to TIMESTAMP_NS columns ====

# ASOF JOIN
query II rowsort
SELECT m1.rn mr, s1.rn sr FROM m1 ASOF JOIN s1 ON m1.n = s1.t AND s1.t = m1.ts
----
1	1
2	2
3	NULL
4	6
5	9
6	NULL

# ASOF JOIN with the equalities swapped
query II rowsort
SELECT m1.rn mr, s1.rn sr FROM m1 ASOF JOIN s1 ON s1.t = m1.ts AND m1.n = s1.t
----
1	1
2	2
3	NULL
4	6
5	9
6	NULL

# ASOF JOIN with a WHERE clause that drops the unmatched rows of m1
query II rowsort
SELECT m1.rn mr, s1.rn sr FROM m1 ASOF JOIN s1 ON m1.n = s1.t AND s1.t = m1.ts WHERE s1.l > 0
----
1	1
2	2
5	9

# LT JOIN
query II rowsort
SELECT m1.rn mr, s1.rn sr FROM m1 LT JOIN s1 ON m1.n = s1.t AND s1.t = m1.ts
----
1	1
2	2
3	NULL
4	6
5	8
6	NULL

# LT JOIN with a WHERE clause that drops the unmatched rows of m1
query II rowsort
SELECT m1.rn mr, s1.rn sr FROM m1 LT JOIN s1 ON m1.n = s1.t AND s1.t = m1.ts WHERE s1.l > 0
----
1	1
2	2
5	8

# ==== designated TIMESTAMP_NS next to TIMESTAMP columns ====

# ASOF JOIN
query II rowsort
SELECT m2.rn mr, s2.rn sr FROM m2 ASOF JOIN s2 ON m2.n = s2.t AND s2.t = m2.ts
----
1	1
2	2
3	NULL
4	6
5	9
6	NULL

# LT JOIN with a WHERE clause that drops the unmatched rows of m2
query II rowsort
SELECT m2.rn mr, s2.rn sr FROM m2 LT JOIN s2 ON m2.n = s2.t AND s2.t = m2.ts WHERE s2.l > 0
----
1	1
2	2
5	8

# ==== columns of one type ====

# ASOF JOIN
query II rowsort
SELECT m3.rn mr, s3.rn sr FROM m3 ASOF JOIN s3 ON m3.n = s3.t AND s3.t = m3.ts
----
1	1
2	2
3	NULL
4	6
5	9
6	NULL

# LT JOIN
query II rowsort
SELECT m3.rn mr, s3.rn sr FROM m3 LT JOIN s3 ON m3.n = s3.t AND s3.t = m3.ts
----
1	1
2	2
3	NULL
4	6
5	8
6	NULL

# ASOF JOIN with a WHERE clause that drops the unmatched rows of m3
query II rowsort
SELECT m3.rn mr, s3.rn sr FROM m3 ASOF JOIN s3 ON m3.n = s3.t AND s3.t = m3.ts WHERE s3.l > 0
----
1	1
2	2
5	9

# ==== the designated timestamp of one table and a column of another ====

# ASOF JOIN
query II rowsort
SELECT mc.rn mr, s3.rn sr FROM mc JOIN y ON y.rn = mc.rn ASOF JOIN s3 ON s3.t = mc.ts AND s3.t = y.n
----
1	1
2	2
3	NULL
4	6
5	9
6	NULL

# ASOF JOIN with a WHERE clause that drops the unmatched rows of mc
query II rowsort
SELECT mc.rn mr, s3.rn sr FROM mc JOIN y ON y.rn = mc.rn ASOF JOIN s3 ON s3.t = mc.ts AND s3.t = y.n WHERE s3.l > 0
----
1	1
2	2
5	9

# LT JOIN
query II rowsort
SELECT mc.rn mr, s3.rn sr FROM mc JOIN y ON y.rn = mc.rn LT JOIN s3 ON s3.t = mc.ts AND s3.t = y.n
----
1	1
2	2
3	NULL
4	6
5	8
6	NULL

# ASOF JOIN after a CROSS JOIN, with a WHERE clause that drops the unmatched rows
query III rowsort
SELECT mc.rn mr, y.rn yr, s3.rn sr FROM mc CROSS JOIN y ASOF JOIN s3 ON s3.t = mc.ts AND s3.t = y.n WHERE s3.l > 0
----
1	1	1
2	2	2
5	5	9

# LT JOIN after a CROSS JOIN, with a WHERE clause that drops the unmatched rows
query III rowsort
SELECT mc.rn mr, y.rn yr, s3.rn sr FROM mc CROSS JOIN y LT JOIN s3 ON s3.t = mc.ts AND s3.t = y.n WHERE s3.l > 0
----
1	1	1
2	2	2
5	5	8
