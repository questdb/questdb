# ASOF and LT JOINs whose ON clause ties one column of the joined table to the designated
# timestamp of the preceding side and to another of its columns, as in
# ON s.t = m.ts AND s.t = m.n, so a row of the joined table matches only when its t equals
# both. The two columns of m differ in m row 3, by 1 nanosecond or 1 microsecond, and m.n is
# NULL in m row 6. Row 6 of the joined table, the latest match of m row 4, has l = 0, and
# row 9 arrives at the timestamp of m row 5, which ASOF matches and LT does not. The expected
# rows come from DuckDB ASOF LEFT JOINs with m.ts >= s.ts for ASOF and m.ts > s.ts for LT,
# and with both sides of each key cast to TIMESTAMP_NS. No row depends on QuestDB matching
# NULL to NULL in join keys, as no row of the joined table equals both a NULL and a
# non-NULL value. The tables are not partitioned, so they are not WAL tables and inserted
# rows are visible at once.

statement ok
DROP TABLE IF EXISTS m1

statement ok
DROP TABLE IF EXISTS s1

statement ok
DROP TABLE IF EXISTS m2

statement ok
DROP TABLE IF EXISTS s2

statement ok
DROP TABLE IF EXISTS m3

statement ok
DROP TABLE IF EXISTS s3

statement ok
DROP TABLE IF EXISTS mc

statement ok
DROP TABLE IF EXISTS y

statement ok
CREATE TABLE m1 (rn INT, n TIMESTAMP_NS, ts TIMESTAMP) TIMESTAMP(ts)

statement ok
CREATE TABLE s1 (rn INT, t TIMESTAMP_NS, l LONG, ts TIMESTAMP) TIMESTAMP(ts)

statement ok
CREATE TABLE m2 (rn INT, n TIMESTAMP, ts TIMESTAMP_NS) TIMESTAMP(ts)

statement ok
CREATE TABLE s2 (rn INT, t TIMESTAMP, l LONG, ts TIMESTAMP_NS) TIMESTAMP(ts)

statement ok
CREATE TABLE m3 (rn INT, n TIMESTAMP, ts TIMESTAMP) TIMESTAMP(ts)

statement ok
CREATE TABLE s3 (rn INT, t TIMESTAMP, l LONG, ts TIMESTAMP) TIMESTAMP(ts)

statement ok
CREATE TABLE mc (rn INT, ts TIMESTAMP) TIMESTAMP(ts)

statement ok
CREATE TABLE y (rn INT, n TIMESTAMP)

statement ok
