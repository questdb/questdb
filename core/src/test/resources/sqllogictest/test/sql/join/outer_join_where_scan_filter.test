# WHERE conjuncts on tables that run before a RIGHT or FULL join. The join NULL-extends those
# tables, so each conjunct filters after the join. When a conjunct of a table is false on the NULL
# row of the table, QuestDB also filters the scan of the table with copies of its conjuncts; the
# rows must not change.
# The expected rows come from DuckDB. QuestDB differs from it in these places:
# - NULL != 1 is true in QuestDB: DuckDB runs t0.c != 1 as t0.c IS DISTINCT FROM 1.
# - t0.ts IN '2024-01-05' is a QuestDB interval: DuckDB runs it as
#   t0.ts >= '2024-01-05' AND t0.ts < '2024-01-06'.
# - LATEST ON has no DuckDB counterpart, so this file does not cover it.
# The tables bypass WAL, so inserted rows are visible at once.

statement ok
DROP TABLE IF EXISTS t0

statement ok
DROP TABLE IF EXISTS t1

statement ok
DROP TABLE IF EXISTS t2

statement ok
CREATE TABLE t0 (rn INT, c INT, k INT, s SYMBOL, ts TIMESTAMP) TIMESTAMP(ts) PARTITION BY DAY BYPASS WAL

statement ok
CREATE TABLE t1 (k INT)

statement ok
CREATE TABLE t2 (k INT)

statement ok
INSERT INTO t0 VALUES (1, 1, 0, 'a', '2024-01-05T01:00:00.000000Z'), (2, 2, 1, 'b', '2024-01-05T02:00:00.000000Z'), (3, NULL, 2, NULL, '2024-01-05T03:00:00.000000Z'), (4, 1, 3, 'a', '2024-01-06T01:00:00.000000Z')

statement ok
INSERT INTO t1 VALUES (0), (1), (5)

statement ok
INSERT INTO t2 VALUES (0), (1), (2), (9)

# an interval on the table before a CROSS join and a RIGHT join; t2 rows 2 and 9 become NULL rows
query III rowsort
SELECT t0.rn, t1.k k1, t2.k k2 FROM t0 CROSS JOIN t1 RIGHT JOIN t2 ON t2.k = t1.k WHERE t0.ts IN '2024-01-05'
----
1	0	0
1	1	1
2	0	0
2	1	1
3	0	0
3	1	1

# the same with a FULL join, which keeps the t0 x t1 rows that match no t2 row
query III rowsort
SELECT t0.rn, t1.k k1, t2.k k2 FROM t0 CROSS JOIN t1 FULL JOIN t2 ON t2.k = t1.k WHERE t0.ts IN '2024-01-05'
----
1	0	0
1	1	1
1	5	NULL
2	0	0
2	1	1
2	5	NULL
3	0	0
3	1	1
3	5	NULL

# the interval as a half-open range of literals
query III rowsort
SELECT t0.rn, t1.k k1, t2.k k2 FROM t0 CROSS JOIN t1 RIGHT JOIN t2 ON t2.k = t1.k WHERE t0.ts >= '2024-01-05' AND t0.ts < '2024-01-06'
----
1	0	0
1	1	1
2	0	0
2	1	1
3	0	0
3	1	1

# the same range from 01:30 with a FULL join
query III rowsort
SELECT t0.rn, t1.k k1, t2.k k2 FROM t0 CROSS JOIN t1 FULL JOIN t2 ON t2.k = t1.k WHERE t0.ts >= '2024-01-05T01:30:00.000000Z' AND t0.ts < '2024-01-06'
----
2	0	0
2	1	1
2	5	NULL
3	0	0
3	1	1
3	5	NULL

# != is true on NULL, so it keeps r3 and the NULL row of t2 row 9 (DuckDB: IS DISTINCT FROM)
query III rowsort
SELECT t0.rn, t1.k k1, t2.k k2 FROM t0 CROSS JOIN t1 RIGHT JOIN t2 ON t2.k = t0.k WHERE t0.c != 1
----
2	0	1
2	1	1
2	5	1
3	0	2
3	1	2
3	5	2
NULL	NULL	9

query III rowsort
SELECT t0.rn, t1.k k1, t2.k k2 FROM t0 CROSS JOIN t1 FULL JOIN t2 ON t2.k = t0.k WHERE t0.c != 1
----
2	0	1
2	1	1
2	5	1
3	0	2
3	1	2
3	5	2
NULL	NULL	9

query III rowsort
SELECT t0.rn, t1.k k1, t2.k k2 FROM t0 CROSS JOIN t1 RIGHT JOIN t2 ON t2.k = t0.k WHERE t0.c = 1
----
1	0	0
1	1	0
1	5	0

# the FULL join keeps r4, which matches no t2 row
query III rowsort
SELECT t0.rn, t1.k k1, t2.k k2 FROM t0 CROSS JOIN t1 FULL JOIN t2 ON t2.k = t0.k WHERE t0.c = 1
----
1	0	0
1	1	0
1	5	0
4	0	NULL
4	1	NULL
4	5	NULL

query III rowsort
SELECT t0.rn, t1.k k1, t2.k k2 FROM t0 CROSS JOIN t1 RIGHT JOIN t2 ON t2.k = t0.k WHERE t0.c IS NULL
----
3	0	2
3	1	2
3	5	2
NULL	NULL	9

query III rowsort
SELECT t0.rn, t1.k k1, t2.k k2 FROM t0 CROSS JOIN t1 RIGHT JOIN t2 ON t2.k = t0.k WHERE t0.ts BETWEEN '2024-01-05' AND '2024-01-05T23:59:00.000000Z'
----
1	0	0
1	1	0
1	5	0
2	0	1
2	1	1
2	5	1
3	0	2
3	1	2
3	5	2

# a non-equi join before the RIGHT join
query III rowsort
SELECT t0.rn, t1.k k1, t2.k k2 FROM t0 JOIN t1 ON t1.k > t0.k RIGHT JOIN t2 ON t2.k = t1.k WHERE t0.c IN (1, 2)
----
1	1	1

statement ok
DROP TABLE t0

statement ok
DROP TABLE t1

statement ok
DROP TABLE t2
