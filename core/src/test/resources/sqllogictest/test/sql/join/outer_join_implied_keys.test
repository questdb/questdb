statement ok
CREATE TABLE pa (rn INT, id INT, x INT, y INT, w INT, ts TIMESTAMP) TIMESTAMP(ts)

statement ok
CREATE TABLE pb (rn INT, k INT, m INT, v INT, ts TIMESTAMP) TIMESTAMP(ts)

statement ok
CREATE TABLE q (rn INT, id INT, ts TIMESTAMP) TIMESTAMP(ts)

