# An INNER join after a non-equi FULL join and a CROSS join, keyed to both the CROSS join and the
# first table
query IIII rowsort
SELECT a.rn ar, b.rn br, c.rn cr, d.rn dr FROM a FULL JOIN b ON b.k > a.k CROSS JOIN c JOIN d ON d.k = c.k AND d.j = a.j
----
1	2	2	1
1	4	2	1
2	2	3	2
2	4	3	2
4	4	2	1

# A LEFT join whose implied key reads a CROSS join that consumes the rows of a non-equi RIGHT
# join, before a non-equi FULL join. b.k >= a.k holds where both keys are NULL, which DuckDB writes as
# b.k > a.k OR b.k IS NOT DISTINCT FROM a.k
query IIIII rowsort
SELECT a.rn ar, b.rn br, c.rn cr, d.rn dr, e.rn er FROM a RIGHT JOIN b ON b.k >= a.k CROSS JOIN c LEFT JOIN d ON d.j = c.j AND d.j = a.j FULL JOIN e ON e.k > a.k
----
1	1	1	1	2
1	1	2	NULL	2
1	1	3	NULL	2
1	2	1	1	2
1	2	2	NULL	2
1	2	3	NULL	2
1	4	1	1	2
1	4	2	NULL	2
1	4	3	NULL	2
2	2	1	NULL	2
2	2	2	2	2
2	2	3	NULL	2
2	4	1	NULL	2
2	4	2	2	2
2	4	3	NULL	2
3	3	1	NULL	NULL
3	3	2	NULL	NULL
3	3	3	NULL	NULL
4	2	1	1	2
4	2	2	NULL	2
4	2	3	NULL	2
4	4	1	1	2
4	4	2	NULL	2
4	4	3	NULL	2
NULL	NULL	NULL	NULL	1
NULL	NULL	NULL	NULL	3

# A non-equi RIGHT join consumed by an INNER join, then a RIGHT join with a join key
query IIII rowsort
SELECT a.rn ar, b.rn br, c.rn cr, d.rn dr FROM a RIGHT JOIN b ON b.k < a.k JOIN c ON c.k = b.k RIGHT JOIN d ON d.k = c.k
----
NULL	3	3	2
NULL	NULL	NULL	1
NULL	NULL	NULL	3

# A LEFT join without join keys before FULL joins with join keys, which leave it unpinned and
# pin the rest of their prefixes
query IIIII rowsort
SELECT a.rn ar, b.rn br, c.rn cr, d.rn dr, e.rn er FROM a JOIN b ON b.k = a.k LEFT JOIN c ON c.j > 15 FULL JOIN d ON d.k = b.k FULL JOIN e ON e.k = a.k
----
1	1	2	NULL	1
1	1	3	NULL	1
3	3	2	2	3
3	3	3	2	3
4	2	2	NULL	NULL
4	2	3	NULL	NULL
NULL	NULL	NULL	1	3
NULL	NULL	NULL	3	3
NULL	NULL	NULL	NULL	2

