# the RIGHT JOIN to l has a filter, l.k > 2
query III rowsort
SELECT a.k, cn.id, l.k lk FROM a LEFT JOIN cn ON a.x >= cn.y JOIN b ON a.k = b.k RIGHT JOIN l ON b.k = l.k AND l.k > 2 WHERE (a.x > 0 AND false) OR now() < '2000-01-01'
----

query III rowsort
SELECT a.k, cn.id, l.k lk FROM a LEFT JOIN cn ON a.x >= cn.y JOIN b ON a.k = b.k RIGHT JOIN l ON b.k = l.k AND l.k > 2 WHERE (a.x > 0 AND false) OR now() > '2000-01-01'
----
4	1	4
4	3	4
NULL	NULL	1
NULL	NULL	2
NULL	NULL	3

