# NaNs
query I
with a as (
	select 'NaN'::double as num
	union all
	select generate_series::double as num from generate_series(1,99)
	union all
	select 'NaN'::double as num
)
select quantile_disc(num, 0.9) c1
from a;
----
90.000000

query I
with a as (
	select 'NaN'::float as num
	union all
	select generate_series::float as num from generate_series(1,99)
	union all
	select 'NaN'::float as num
)
select quantile_disc(num, 0.9) c1
from a;
----
90.000000
