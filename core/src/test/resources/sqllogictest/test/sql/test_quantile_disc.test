# Negative quantiles (use descending intervals)
# DuckDB reads a negative quantile as the quantile in descending order.
# QuestDB rejects it, as the SQL standard does; negating the values gives the
# descending order and DuckDB's result.
statement error
SELECT quantile_disc(col, -0.5)
FROM
( SELECT 11000 col UNION SELECT 3100 col UNION SELECT 2900 col UNION SELECT 2800 col UNION SELECT 2600 col UNION SELECT 2500 col );

query I
SELECT -quantile_disc(-col, 0.5)
FROM
( SELECT 11000 col UNION SELECT 3100 col UNION SELECT 2900 col UNION SELECT 2800 col UNION SELECT 2600 col UNION SELECT 2500 col );
----
2900

# the ascending median of the same values
query I
SELECT quantile_disc(col, 0.5)
FROM
( SELECT 11000 col UNION SELECT 3100 col UNION SELECT 2900 col UNION SELECT 2800 col UNION SELECT 2600 col UNION SELECT 2500 col );
----
2800

