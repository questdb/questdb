# The first value whose cumulative distribution reaches the fraction. 0.07 * 100
# evaluates to 7.000000000000001, yet the 7th of 100 values has the cumulative
# distribution 7 / 100 = 0.07. DuckDB returns 7, 14, 28, 55 and 56; PostgreSQL
# returns the next values up.
query IIIII
SELECT quantile_disc(x, 0.07), quantile_disc(x, 0.14), quantile_disc(x, 0.28), quantile_disc(x, 0.55), quantile_disc(x, 0.56) FROM long_sequence(100)
----
7 14 28 55 56

query RRRRR
SELECT quantile_disc(x::double, 0.07), quantile_disc(x::double, 0.14), quantile_disc(x::double, 0.28), quantile_disc(x::double, 0.55), quantile_disc(x::double, 0.56) FROM long_sequence(100)
----
7.000000 14.000000 28.000000 55.000000 56.000000

query I
SELECT min(x) FROM (SELECT x, cume_dist() OVER (ORDER BY x) cd FROM long_sequence(100)) WHERE cd >= 0.07
----
7

query R
SELECT quantile_disc(x::double, 0.07) OVER () FROM long_sequence(100) LIMIT 1
----
7.000000

# Integral extremes, after DuckDB's test_quantile_cont.test. The LONG
# variant returns the exact value.
statement ok
CREATE TABLE tinyints (t BYTE);

statement ok
INSERT INTO tinyints VALUES (-127), (-127);

query I
SELECT quantile_disc(t, 0.5) FROM tinyints;
----
-127

statement ok
UPDATE tinyints SET t = -t;

query I
SELECT quantile_disc(t, 0.5) FROM tinyints;
----
127

statement ok
