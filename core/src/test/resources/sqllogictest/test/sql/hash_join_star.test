# Suppliers over three day partitions: product 12 has two, products 10, 11 and 13 one each. A LIKE
# over the name, which QuestDB's JIT does not compile, filters the rows that the join hashes.
statement ok
CREATE TABLE suppliers (prod INT, sname VARCHAR, ts TIMESTAMP) TIMESTAMP(ts) PARTITION BY DAY BYPASS WAL

statement ok
INSERT INTO suppliers VALUES
(10, 'Acme', '2024-01-01T00:00:00.000000Z'),
(12, 'Alpine', '2024-01-02T00:00:00.000000Z'),
(12, 'Valley', '2024-01-02T01:00:00.000000Z'),
(13, 'Bakers', '2024-01-03T00:00:00.000000Z'),
(11, 'Mill', '2024-01-03T01:00:00.000000Z')

# INNER star of three dimensions
query ITTT nosort
SELECT s.id, c.cname, p.pname, st.city
FROM sales s
JOIN customers c ON s.cust = c.cust
JOIN products p ON s.prod = p.prod
JOIN stores st ON s.store = st.store
ORDER BY s.id, c.cname, p.pname, st.city
----
1 Ann apple Paris
2 Bea bread Paris
2 Bob bread Paris
3 Cid apple Berlin
7 Cid cheddar Berlin
7 Cid cheese Berlin
8 Dan apple Austin
8 Dan apple Boston

# LEFT star of three dimensions
query ITTT nosort
SELECT s.id, c.cname, p.pname, st.city
FROM sales s
LEFT JOIN customers c ON s.cust = c.cust
LEFT JOIN products p ON s.prod = p.prod
LEFT JOIN stores st ON s.store = st.store
ORDER BY s.id, c.cname, p.pname, st.city
----
1 Ann apple Paris
2 Bea bread Paris
2 Bob bread Paris
3 Cid apple Berlin
4 NULL cheddar Austin
4 NULL cheddar Boston
4 NULL cheese Austin
4 NULL cheese Boston
5 Bea NULL Paris
5 Bob NULL Paris
6 Ann bread NULL
7 Cid cheddar Berlin
7 Cid cheese Berlin
8 Dan apple Austin
8 Dan apple Boston

# The same LEFT star, counted
query I nosort
SELECT count(*)
FROM sales s
LEFT JOIN customers c ON s.cust = c.cust
LEFT JOIN products p ON s.prod = p.prod
LEFT JOIN stores st ON s.store = st.store
----
15

# The INNER star of two dimensions that repeat keys, customer 2 and product 12, counted: sales rows 1
# to 8 meet 1, 2, 1, 0, 0, 1, 2 and 1 pairs
query I nosort
SELECT count(*)
FROM sales s
JOIN customers c ON s.cust = c.cust
JOIN products p ON s.prod = p.prod
----
8

# INNER, then LEFT
query ITT nosort
SELECT s.id, c.cname, p.pname
FROM sales s
JOIN customers c ON s.cust = c.cust
LEFT JOIN products p ON s.prod = p.prod
ORDER BY s.id, c.cname, p.pname
----
1 Ann apple
2 Bea bread
2 Bob bread
3 Cid apple
5 Bea NULL
5 Bob NULL
6 Ann bread
7 Cid cheddar
7 Cid cheese
8 Dan apple

# LEFT, then INNER
query ITT nosort
SELECT s.id, c.cname, p.pname
FROM sales s
LEFT JOIN customers c ON s.cust = c.cust
JOIN products p ON s.prod = p.prod
ORDER BY s.id, c.cname, p.pname
----
1 Ann apple
2 Bea bread
2 Bob bread
3 Cid apple
4 NULL cheddar
4 NULL cheese
6 Ann bread
7 Cid cheddar
7 Cid cheese
8 Dan apple

# A LEFT join's ON residual that some of a row's pairs fail and that all of them fail
query ITT nosort
SELECT s.id, c.cname, p.pname
FROM sales s
JOIN customers c ON s.cust = c.cust
LEFT JOIN products p ON s.prod = p.prod AND p.price > 10
ORDER BY s.id, c.cname, p.pname
----
1 Ann NULL
2 Bea NULL
2 Bob NULL
3 Cid NULL
5 Bea NULL
5 Bob NULL
6 Ann NULL
7 Cid cheddar
7 Cid cheese
8 Dan NULL

# A LEFT join's ON residual that reads an earlier join's columns
query ITT nosort
SELECT s.id, c.cname, st.city
FROM sales s
LEFT JOIN customers c ON s.cust = c.cust
LEFT JOIN stores st ON s.store = st.store AND (c.region = 'US' OR st.city = 'Berlin')
ORDER BY s.id, c.cname, st.city
----
1 Ann NULL
2 Bea NULL
2 Bob Paris
3 Cid Berlin
4 NULL NULL
5 Bea NULL
5 Bob Paris
6 Ann NULL
7 Cid Berlin
8 Dan Austin
8 Dan Boston

# A post-join WHERE over the fact table and two dimensions
query ITT nosort
SELECT s.id, c.cname, p.pname
FROM sales s
JOIN customers c ON s.cust = c.cust
JOIN products p ON s.prod = p.prod
WHERE p.price * s.qty >= 3 AND c.region <> 'EU'
ORDER BY s.id, c.cname, p.pname
----
2 Bob bread
3 Cid apple
7 Cid cheddar
7 Cid cheese
8 Dan apple

# A later LEFT join's misses alone
query II nosort
SELECT s.id, s.store
FROM sales s
JOIN customers c ON s.cust = c.cust
LEFT JOIN stores st ON s.store = st.store
WHERE st.store IS NULL
ORDER BY s.id, c.cname
----
6 103

# A post-join WHERE on a later LEFT join
query IIT nosort
SELECT s.id, ch.fee, st.city
FROM sales s
LEFT JOIN channels ch ON s.channel = ch.channel
LEFT JOIN stores st ON s.store = st.store
WHERE ch.fee IS NULL OR st.city LIKE 'B%'
ORDER BY s.id, ch.fee, st.city
----
3 1 Berlin
3 2 Berlin
4 NULL Austin
4 NULL Boston
7 0 Berlin
8 1 Boston
8 2 Boston

# A SYMBOL key (VARCHAR in DuckDB)
query IIT nosort
SELECT s.id, ch.fee, c.cname
FROM sales s
JOIN channels ch ON s.channel = ch.channel
LEFT JOIN customers c ON s.cust = c.cust
ORDER BY s.id, ch.fee, c.cname
----
1 1 Ann
1 2 Ann
2 0 Bea
2 0 Bob
3 1 Cid
3 2 Cid
5 0 Bea
5 0 Bob
6 1 Ann
6 2 Ann
7 0 Cid
8 1 Dan
8 2 Dan

# GROUP BY over a star
query TII nosort
SELECT c.region, count(*), sum(s.qty)
FROM sales s
JOIN customers c ON s.cust = c.cust
LEFT JOIN products p ON s.prod = p.prod
GROUP BY c.region
ORDER BY c.region
----
APAC 3 17
EU 4 8
US 3 7

# Window functions over a star with a post-join WHERE
query ITTIR nosort
SELECT s.id, c.cname, p.pname,
    row_number() OVER (ORDER BY s.ts, p.pname, c.cname) AS rn,
    sum(s.qty) OVER (PARTITION BY c.region ORDER BY s.ts, p.pname, c.cname) AS running
FROM sales s
JOIN customers c ON s.cust = c.cust
JOIN products p ON s.prod = p.prod
WHERE p.price < s.qty * 5
ORDER BY s.id, c.cname, p.pname
----
1 Ann apple 1 2.000000
2 Bea bread 2 3.000000
2 Bob bread 3 1.000000
3 Cid apple 4 5.000000
6 Ann bread 5 4.000000
7 Cid cheddar 6 11.000000
7 Cid cheese 7 17.000000
8 Dan apple 8 3.000000

# ORDER BY and LIMIT over a star
query ITT nosort
SELECT s.id, c.cname, st.city
FROM sales s
JOIN customers c ON s.cust = c.cust
JOIN stores st ON s.store = st.store
ORDER BY s.ts DESC, c.cname, st.city
LIMIT 4
----
8 Dan Austin
8 Dan Boston
7 Cid Berlin
5 Bea Paris

# An INNER first join whose left table is the smaller, with a LEFT join keyed on that table
query ITT rowsort
SELECT s.id, st.city, m.manager
FROM stores st
JOIN sales s ON st.store = s.store
LEFT JOIN managers m ON st.store = m.store
----
1 Paris Mia
2 Paris Mia
3 Berlin NULL
4 Austin Noa
4 Austin Oli
4 Boston Noa
4 Boston Oli
5 Paris Mia
7 Berlin NULL
8 Austin Noa
8 Austin Oli
8 Boston Noa
8 Boston Oli

# A LEFT join over the suppliers that a LIKE keeps: Acme and Alpine
query IT nosort
SELECT s.id, su.sname
FROM sales s
LEFT JOIN (SELECT * FROM suppliers WHERE sname LIKE 'A%') su ON s.prod = su.prod
ORDER BY s.id, su.sname
----
1 Acme
2 NULL
3 Acme
4 Alpine
5 NULL
6 NULL
7 Alpine
8 Acme

# GROUP BY over an INNER join with the suppliers whose name holds an l: Alpine and Valley supply
# product 12, sold twice for 3 and 6, and Mill product 11, sold twice for 1 and 1
query TII nosort
SELECT su.sname, count(*), sum(s.qty)
FROM sales s
JOIN (SELECT * FROM suppliers WHERE sname LIKE '%l%') su ON s.prod = su.prod
GROUP BY su.sname
ORDER BY su.sname
----
Alpine 2 9
Mill 2 2
Valley 2 9

# ---------------------------------------------------------------------------------------------
# QuestDB-specific
# ---------------------------------------------------------------------------------------------

# The row order without ORDER BY: the sales rows in their order, each one's customers newest
# first (Bea before Bob), and within each customer the products newest first (cheddar before
# cheese). DuckDB leaves the order undefined.
query ITT nosort
SELECT s.id, c.cname, p.pname
FROM sales s
JOIN customers c ON s.cust = c.cust
JOIN products p ON s.prod = p.prod
----
1 Ann apple
2 Bea bread
2 Bob bread
3 Cid apple
6 Ann bread
7 Cid cheddar
7 Cid cheese
8 Dan apple

# The stores table has fewer rows than the sales table, so the INNER first join hashes the stores
# and streams the sales: the rows come in the sales order, each sale's stores newest first, and
# each store's managers newest first.
query ITT nosort
SELECT s.id, st.city, m.manager
FROM stores st
JOIN sales s ON st.store = s.store
LEFT JOIN managers m ON st.store = m.store
----
1 Paris Mia
2 Paris Mia
3 Berlin NULL
4 Boston Oli
4 Boston Noa
4 Austin Oli
4 Austin Noa
5 Paris Mia
7 Berlin NULL
8 Boston Oli
8 Boston Noa
8 Austin Oli
8 Austin Noa

# An ORDER BY on the left table's timestamp fixes the order to the stores', so the join keeps
# its inputs: each store's sales newest first.
query ITT nosort
SELECT s.id, st.city, m.manager
FROM stores st
JOIN sales s ON st.store = s.store
LEFT JOIN managers m ON st.store = m.store
ORDER BY st.ts
----
5 Paris Mia
2 Paris Mia
1 Paris Mia
7 Berlin NULL
3 Berlin NULL
8 Austin Oli
8 Austin Noa
4 Austin Oli
4 Austin Noa
8 Boston Oli
8 Boston Noa
4 Boston Oli
4 Boston Noa

# A negative LIMIT takes the last rows of the star, in the order above.
query ITT nosort
SELECT s.id, c.cname, st.city
FROM sales s
LEFT JOIN customers c ON s.cust = c.cust
LEFT JOIN stores st ON s.store = st.store
LIMIT -3
----
7 Cid Berlin
8 Dan Boston
8 Dan Austin

statement ok
CREATE TABLE nf (id INT, k INT, ts TIMESTAMP) TIMESTAMP(ts)

statement ok
INSERT INTO nf VALUES
(1, NULL, '2024-01-01T00:00:00.000000Z'),
(2, 1, '2024-01-01T01:00:00.000000Z'),
(3, 2, '2024-01-01T02:00:00.000000Z')

statement ok
CREATE TABLE nd (k INT, v VARCHAR, ts TIMESTAMP) TIMESTAMP(ts)

statement ok
INSERT INTO nd VALUES
(NULL, 'none', '2024-01-01T00:00:00.000000Z'),
(1, 'one', '2024-01-01T01:00:00.000000Z')

# NULL keys match NULL keys. DuckDB matches no NULL key, so it returns the row of id 2 alone.
query ITT nosort
SELECT nf.id, a.v, b.v
FROM nf
LEFT JOIN nd a ON nf.k = a.k
JOIN nd b ON nf.k = b.k
ORDER BY nf.id
----
1 none none
2 one one
