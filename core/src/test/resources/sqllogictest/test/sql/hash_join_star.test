# name: test/sql/hash_join_star.test
# description: INNER and LEFT star joins: a fact table joined with several dimensions on its own keys
# group: [join]
#
# The runner starts QuestDB with cairo.sql.parallel.hash.join.enabled=true, so these joins run
# on the parallel hash join, which stacks the joins of a star into stages of one operator;
# HashJoinStarSqllogicTest checks that the runner's server plans them so. The queries above the
# "QuestDB-specific" line follow DuckDB semantics, and DuckDB returns their expected rows. Two
# types differ, which leaves the values alone: the SYMBOL key column is a VARCHAR in DuckDB, and
# QuestDB's window sum() of an INT column returns a DOUBLE where DuckDB's returns an integer. The
# window functions' default frame differs as well, ROWS in QuestDB and RANGE in DuckDB, which agree
# under the total order the windows sort by. Below that line, QuestDB deliberately differs:
# - its hash joins match a NULL key with a NULL key; DuckDB's never match NULL keys;
# - it returns a join's rows in a defined order without ORDER BY: the order of the input it
#   streams, each row's matches in reverse insertion order, and the matches of a later join nested
#   in those of an earlier one; DuckDB leaves that order undefined;
# - an INNER first join of two plain tables hashes the smaller one and streams the larger, so when
#   the left table is the smaller, the rows come in the right table's order, unless the query
#   orders them by the left table's timestamp;
# - a negative LIMIT takes the last rows; DuckDB has no negative LIMIT.

statement ok
CREATE TABLE sales (id INT, cust INT, prod INT, store INT, qty INT, channel SYMBOL, ts TIMESTAMP) TIMESTAMP(ts) PARTITION BY DAY BYPASS WAL

statement ok
INSERT INTO sales VALUES
(1, 1, 10, 100, 2, 'web', '2024-01-01T00:00:00.000000Z'),
(2, 2, 11, 100, 1, 'shop', '2024-01-01T01:00:00.000000Z'),
(3, 3, 10, 101, 5, 'web', '2024-01-01T02:00:00.000000Z'),
(4, 9, 12, 102, 3, 'phone', '2024-01-01T03:00:00.000000Z'),
(5, 2, 13, 100, 4, 'shop', '2024-01-02T00:00:00.000000Z'),
(6, 1, 11, 103, 1, 'web', '2024-01-02T01:00:00.000000Z'),
(7, 3, 12, 101, 6, 'shop', '2024-01-02T02:00:00.000000Z'),
(8, 4, 10, 102, 2, 'web', '2024-01-02T03:00:00.000000Z')

# Customer 2 has two rows and customer 9 none; customer 5 bought nothing.
statement ok
