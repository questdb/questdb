# name: test/sql/test_quantile_cont_list.test
# description: Test QUANTILE_CONT with an array of quantiles
# group: [aggregates]
#
# Ported from DuckDB test/sql/aggregate/aggregates/test_quantile_cont_list.test.
# Differences from DuckDB:
# - QuestDB takes the quantiles as a DOUBLE[] and returns a DOUBLE[]
# - QuestDB has no quantile_cont over DECIMAL, DATE, TIME or INTERVAL values,
#   so those cases are left out; TIMESTAMP goes through a LONG cast
# - DuckDB reads a negative quantile as a quantile in descending order;
#   QuestDB rejects negative quantiles, as the SQL standard does

statement ok
CREATE TABLE quantiles AS (
    SELECT * FROM (
        SELECT (x - 1) * 100 r, rnd_double() q FROM long_sequence(10_000)
        UNION ALL
        SELECT NULL, 0.25
        UNION ALL
        SELECT NULL, 0.5
        UNION ALL
        SELECT NULL, 0.75
    )
    ORDER BY 2
);

# temporal types
query III
SELECT a[1]::long::timestamp, a[2]::long::timestamp, a[3]::long::timestamp
FROM (
    SELECT quantile_cont(dateadd('h', (r / 100)::int, '2021-01-01'::timestamp)::long, ARRAY[0.25, 0.5, 0.75]) a
    FROM quantiles
)
----
2021-04-15 03:45:00 2021-07-28 07:30:00 2021-11-09 11:15:00

# single GROUP
query R
SELECT quantile_cont(r, ARRAY[0.25, 0.5, 0.75]) FROM quantiles
----
{2.49975e+5,4.9995e+5,7.49925e+5}

query R
SELECT percentile_cont(r, ARRAY[0.25, 0.5, 0.75]) FROM quantiles
----
{2.49975e+5,4.9995e+5,7.49925e+5}

# multiple groups
query RR
SELECT r % 1000 g, quantile_cont(r, ARRAY[0.25, 0.5, 0.75]) FROM quantiles GROUP BY 1 ORDER BY 1
----
NULL NULL
0 {2.4975e+5,4.995e+5,7.4925e+5}
100 {2.4985e+5,4.996e+5,7.4935e+5}
200 {2.4995e+5,4.997e+5,7.4945e+5}
300 {2.5005e+5,4.998e+5,7.4955e+5}
400 {2.5015e+5,4.999e+5,7.4965e+5}
500 {2.5025e+5,5e+5,7.4975e+5}
600 {2.5035e+5,5.001e+5,7.4985e+5}
700 {2.5045e+5,5.002e+5,7.4995e+5}
800 {2.5055e+5,5.003e+5,7.5005e+5}
900 {2.5065e+5,5.004e+5,7.5015e+5}

# constant input
query R
SELECT quantile_cont(1, ARRAY[0.25, 0.5, 0.75]) FROM quantiles
----
{1.000000,1.000000,1.000000}

# empty input
query R
SELECT quantile_cont(r, ARRAY[0.25, 0.5, 0.75]) FROM quantiles WHERE 1 = 0
----
NULL

# empty list
query R
SELECT quantile_cont(r, ARRAY[]) FROM quantiles
----
{}

# parallel execution - QuestDB skips the pragma, the queries repeat the above
statement ok
pragma threads=4

statement ok
PRAGMA verify_parallelism

# single GROUP
query R
SELECT quantile_cont(r, ARRAY[0.25, 0.5, 0.75]) FROM quantiles
----
{2.49975e+5,4.9995e+5,7.49925e+5}

