statement error
SELECT approx_percentile(r::double, 'NaN'::double) FROM quantile

statement error
SELECT approx_percentile(r::double, ARRAY[0.5, 'NaN'::double]) FROM quantile

statement error
SELECT approx_percentile(r::double, ARRAY[0.5, 1.1]) FROM quantile

statement error
SELECT approx_percentile(r::double, ARRAY[0.5, -0.1]) FROM quantile

statement error
SELECT approx_percentile(r, ARRAY[-0.5], 3) FROM quantile

statement ok
pragma threads=4

statement ok
PRAGMA verify_parallelism

query I
SELECT abs(approx - exact) <= 100
FROM (SELECT approx_percentile(r::double, 0.1, 2) approx, percentile_disc(r, 0.1) exact FROM quantile)
----
true

query I
SELECT abs(approx - exact) <= 100
FROM (SELECT approx_percentile(r::double, 0.9, 2) approx, percentile_disc(r, 0.9) exact FROM quantile)
----
true

query I
SELECT abs(approx - exact) <= 100
FROM (SELECT approx_percentile(r::double, 0.5, 2) approx, percentile_disc(r, 0.5) exact FROM quantile)
----
true

# multiple groups
query IIII
SELECT g, abs(a[1] - q[1]) <= 100, abs(a[2] - q[2]) <= 100, abs(a[3] - q[3]) <= 100
FROM (
    SELECT r % 10 g, approx_percentile(r::double, ARRAY[0.1, 0.5, 0.9], 2) a, percentile_disc(r, ARRAY[0.1, 0.5, 0.9]) q
    FROM quantile
    WHERE r IS NOT NULL
)
ORDER BY g
----
0 true true true
1 true true true
2 true true true
3 true true true
4 true true true
5 true true true
6 true true true
7 true true true
8 true true true
9 true true true
