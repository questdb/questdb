# lists over partitions
query IRR
SELECT r, quantile_disc(i, ARRAY[0.25, 0.5, 0.75]) OVER (PARTITION BY r % 2), quantile_cont(i, ARRAY[0.25, 0.5, 0.75]) OVER (PARTITION BY r % 2)
FROM t1
ORDER BY 1
----
0 {0.000000,2.000000,4.000000} {1.000000,2.000000,3.000000}
1 {1.000000,3.000000,5.000000} {2.000000,3.000000,4.000000}
2 {0.000000,2.000000,4.000000} {1.000000,2.000000,3.000000}
3 {1.000000,3.000000,5.000000} {2.000000,3.000000,4.000000}
4 {0.000000,2.000000,4.000000} {1.000000,2.000000,3.000000}
5 {1.000000,3.000000,5.000000} {2.000000,3.000000,4.000000}

query IRR
SELECT r, quantile_disc(i, ARRAY[0.25, 0.5, 0.75]) OVER (PARTITION BY r % 3), quantile_cont(i, ARRAY[0.25, 0.5, 0.75]) OVER (PARTITION BY r % 3)
FROM t4
ORDER BY 1
----
0 {0.000000,0.000000,0.000000} {0.000000,0.000000,0.000000}
1 {1.000000,1.000000,1.000000} {1.000000,1.000000,1.000000}
2 {2.000000,2.000000,2.000000} {2.000000,2.000000,2.000000}
3 {0.000000,0.000000,0.000000} {0.000000,0.000000,0.000000}
4 {1.000000,1.000000,1.000000} {1.000000,1.000000,1.000000}
5 {2.000000,2.000000,2.000000} {2.000000,2.000000,2.000000}

#
# Scaled down from DuckDB test/sql/window/test_quantile_window.test_slow:
# one million rows over seven whole partitions. Every row of a partition
# carries the same value, so min() and max() agree.
#

statement ok
CREATE TABLE rank100 AS (SELECT (x - 1) % 100 a, x - 1 b FROM long_sequence(1_000_000));

query IIRRRRRR
SELECT p, count(*), min(c25), max(c25), min(d50), max(d50), min(c999), max(c999)
FROM (
    SELECT b % 7 p,
           quantile_cont(a, 0.25) OVER (PARTITION BY b % 7) c25,
           quantile_disc(a, 0.5) OVER (PARTITION BY b % 7) d50,
           quantile_cont(a, 0.999) OVER (PARTITION BY b % 7) c999
    FROM rank100
)
GROUP BY p
ORDER BY p
----
0 142858 24.250000 24.250000 49.000000 49.000000 99.000000 99.000000
1 142857 25.000000 25.000000 50.000000 50.000000 99.000000 99.000000
2 142857 24.000000 24.000000 49.000000 49.000000 99.000000 99.000000
3 142857 25.000000 25.000000 50.000000 50.000000 99.000000 99.000000
4 142857 25.000000 25.000000 49.000000 49.000000 99.000000 99.000000
5 142857 25.000000 25.000000 50.000000 50.000000 99.000000 99.000000
6 142857 25.000000 25.000000 49.000000 49.000000 99.000000 99.000000

query IRRRRRRRRRR
SELECT p, min(cl[1]), max(cl[1]), min(cl[2]), max(cl[2]), min(cl[3]), max(cl[3]), min(dl[1]), max(dl[1]), min(dl[2]), max(dl[2])
FROM (
    SELECT b % 7 p,
           quantile_cont(a, ARRAY[0.1, 0.5, 0.9]) OVER (PARTITION BY b % 7) cl,
           quantile_disc(a, ARRAY[0.01, 0.99]) OVER (PARTITION BY b % 7) dl
    FROM rank100
)
GROUP BY p
ORDER BY p
----
0 9.700000 9.700000 49.500000 49.500000 89.300000 89.300000 0.000000 0.000000 99.000000 99.000000
1 9.600000 9.600000 50.000000 50.000000 89.400000 89.400000 1.000000 1.000000 99.000000 99.000000
2 9.600000 9.600000 49.000000 49.000000 89.000000 89.000000 0.000000 0.000000 98.000000 98.000000
3 10.000000 10.000000 50.000000 50.000000 89.400000 89.400000 1.000000 1.000000 99.000000 99.000000
4 9.600000 9.600000 49.000000 49.000000 89.000000 89.000000 0.000000 0.000000 98.000000 98.000000
5 10.000000 10.000000 50.000000 50.000000 89.400000 89.400000 1.000000 1.000000 99.000000 99.000000
6 9.600000 9.600000 49.000000 49.000000 89.400000 89.400000 0.000000 0.000000 98.000000 98.000000

query IRRRR
SELECT count(*), min(c25), max(c25), min(d50), max(c999)
FROM (
    SELECT quantile_cont(a, 0.25) OVER () c25, quantile_disc(a, 0.5) OVER () d50, quantile_cont(a, 0.999) OVER () c999
    FROM rank100
)
----
1000000 24.750000 24.750000 49.000000 99.000000

# the aggregates over the same partitions agree with the window functions
query IIRIRR
SELECT b % 7 p, count(*), quantile_cont(a, 0.25), quantile_disc(a, 0.5), quantile_cont(a, 0.999), quantile_cont(a, ARRAY[0.1, 0.5, 0.9])
FROM rank100
GROUP BY p
ORDER BY p
----
0 142858 24.250000 49 99.000000 {9.700000,49.500000,89.300000}
1 142857 25.000000 50 99.000000 {9.600000,50.000000,89.400000}
2 142857 24.000000 49 99.000000 {9.600000,49.000000,89.000000}
3 142857 25.000000 50 99.000000 {10.000000,50.000000,89.400000}
4 142857 25.000000 49 99.000000 {9.600000,49.000000,89.000000}
5 142857 25.000000 50 99.000000 {10.000000,50.000000,89.400000}
6 142857 25.000000 49 99.000000 {9.600000,49.000000,89.400000}

# DuckDB's moving and cumulative frames are not supported
statement error
SELECT r, quantile_cont(r, 0.5) OVER (ORDER BY r ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM quantiles

statement error
SELECT r, quantile_disc(r, ARRAY[0.25, 0.5, 0.75]) OVER (ORDER BY r ROWS BETWEEN 1 PRECEDING AND 2 FOLLOWING) FROM quantiles

statement error
SELECT r % 2, r, quantile_cont(r, 0.5) OVER (PARTITION BY r % 2 ORDER BY r) FROM quantiles
