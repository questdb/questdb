# name: test/sql/test_quantile_window.test
# description: Test PERCENTILE and QUANTILE window functions over whole partitions
# group: [window]
#
# Ported from DuckDB test/sql/window/test_quantile_window.test.
# QuestDB's percentile window functions only support whole-partition frames,
# so DuckDB's moving and cumulative frames become OVER () and
# OVER (PARTITION BY ...). The expected values come from DuckDB's
# median/quantile aggregates over the same partitions; DuckDB's median is
# quantile_cont(x, 0.5).

statement ok
CREATE TABLE quantiles AS (
    SELECT * FROM (
        SELECT x - 1 r FROM long_sequence(10)
        UNION ALL
        SELECT NULL
        UNION ALL
        SELECT NULL
        UNION ALL
        SELECT NULL
    )
);

query III
SELECT r % 2, r, quantile_cont(r, 0.5) OVER (PARTITION BY r % 2) FROM quantiles ORDER BY 1, 2
----
NULL NULL NULL
NULL NULL NULL
NULL NULL NULL
0 0 4.000000
0 2 4.000000
0 4 4.000000
0 6 4.000000
0 8 4.000000
1 1 5.000000
1 3 5.000000
1 5 5.000000
1 7 5.000000
1 9 5.000000

query III
SELECT r % 2, r, quantile_disc(r, 0.5) OVER (PARTITION BY r % 2) FROM quantiles ORDER BY 1, 2
----
NULL NULL NULL
NULL NULL NULL
NULL NULL NULL
0 0 4.000000
0 2 4.000000
0 4 4.000000
0 6 4.000000
0 8 4.000000
1 1 5.000000
1 3 5.000000
1 5 5.000000
1 7 5.000000
1 9 5.000000

query III
SELECT r % 2, r, quantile_cont(r, ARRAY[0.25, 0.75]) OVER (PARTITION BY r % 2) FROM quantiles ORDER BY 1, 2
----
NULL NULL NULL
NULL NULL NULL
NULL NULL NULL
0 0 {2.000000,6.000000}
0 2 {2.000000,6.000000}
0 4 {2.000000,6.000000}
0 6 {2.000000,6.000000}
0 8 {2.000000,6.000000}
1 1 {3.000000,7.000000}
1 3 {3.000000,7.000000}
1 5 {3.000000,7.000000}
1 7 {3.000000,7.000000}
1 9 {3.000000,7.000000}

query IRRRR
SELECT r, percentile_cont(r, 0.5) OVER (), quantile_disc(r, 0.5) OVER (),
       quantile_disc(r, ARRAY[0.1, 0.5, 0.9]) OVER (), quantile_cont(r, ARRAY[0.1, 0.5, 0.9]) OVER ()
FROM quantiles
ORDER BY 1
----
NULL 4.500000 4.000000 {0.000000,4.000000,8.000000} {0.900000,4.500000,8.100000}
