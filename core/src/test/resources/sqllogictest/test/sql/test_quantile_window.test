#
# Coverage data sets of DuckDB's moving-frame tests, over the whole frame
#

statement ok
CREATE TABLE t1 AS (SELECT x - 1 r, x - 1 i FROM long_sequence(6));

statement ok
CREATE TABLE t2 AS (SELECT x - 1 r, CASE WHEN x = 1 THEN NULL ELSE x - 1 END i FROM long_sequence(6));

statement ok
CREATE TABLE t3 AS (SELECT x - 1 r, NULL::long i FROM long_sequence(6));

statement ok
CREATE TABLE t4 AS (SELECT x - 1 r, (x - 1) % 3 i FROM long_sequence(6));

# discrete list
query IR
SELECT r, quantile_disc(i, ARRAY[0.25, 0.5, 0.75]) OVER () FROM t1 ORDER BY 1
----
0 {1.000000,2.000000,4.000000}
1 {1.000000,2.000000,4.000000}
2 {1.000000,2.000000,4.000000}
3 {1.000000,2.000000,4.000000}
4 {1.000000,2.000000,4.000000}
5 {1.000000,2.000000,4.000000}

# discrete list with NULLs
query IR
