# Scattered NULLs
query IIII
SELECT r % 3, r, n, quantile_cont(n, 0.5) OVER (PARTITION BY r % 3)
FROM (SELECT r, CASE WHEN r % 2 = 0 THEN r ELSE NULL END n FROM quantiles)
ORDER BY 1, 2
----
NULL NULL NULL NULL
NULL NULL NULL NULL
NULL NULL NULL NULL
0 0 0 3.000000
0 3 NULL 3.000000
0 6 6 3.000000
0 9 NULL 3.000000
1 1 NULL 4.000000
1 4 4 4.000000
1 7 NULL 4.000000
2 2 2 5.000000
2 5 NULL 5.000000
2 8 8 5.000000

query IIII
SELECT r % 3, r, n, quantile_disc(n, ARRAY[0.25, 0.75]) OVER (PARTITION BY r % 3)
FROM (SELECT r, CASE WHEN r % 2 = 0 THEN r ELSE NULL END n FROM quantiles)
ORDER BY 1, 2
----
NULL NULL NULL NULL
NULL NULL NULL NULL
NULL NULL NULL NULL
0 0 0 {0.000000,6.000000}
0 3 NULL {0.000000,6.000000}
0 6 6 {0.000000,6.000000}
0 9 NULL {0.000000,6.000000}
1 1 NULL {4.000000,4.000000}
1 4 4 {4.000000,4.000000}
1 7 NULL {4.000000,4.000000}
2 2 2 {2.000000,8.000000}
2 5 NULL {2.000000,8.000000}
2 8 8 {2.000000,8.000000}

query III
SELECT r, n, quantile_cont(n, 0.5) OVER ()
FROM (SELECT r, CASE WHEN r % 2 = 0 THEN r ELSE NULL END n FROM quantiles)
ORDER BY 1
