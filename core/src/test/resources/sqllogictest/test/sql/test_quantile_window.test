----
0 {2.000000,3.000000,4.000000}
1 {2.000000,3.000000,4.000000}
2 {2.000000,3.000000,4.000000}
3 {2.000000,3.000000,4.000000}
4 {2.000000,3.000000,4.000000}
5 {2.000000,3.000000,4.000000}

# discrete list with all NULLs
query IR
SELECT r, quantile_disc(i, ARRAY[0.25, 0.5, 0.75]) OVER () FROM t3 ORDER BY 1
----
0 NULL
1 NULL
2 NULL
3 NULL
4 NULL
5 NULL

