# INT a: no field id, INT b: field id 0, no row group
query II
SELECT b, a FROM read_parquet('data/parquet-testing/partial_field_ids_empty.parquet')
----

query II
SELECT count(), sum(a) FROM read_parquet('data/parquet-testing/partial_field_ids_empty.parquet')
----
0	NULL

# b, s, f and n: no field id; a, ts, d and k: field ids 0, 2, 4 and 6. The test runner prints a DOUBLE
# of 1e5 or more in exponent notation: 7.809375e+5 is DuckDB's 780937.5.
query IIIIIIRTTII
SELECT count(), count(b), count(a), count(s), count(n), sum(b), sum(a), sum(d), min(ts), max(ts), sum(k) FROM read_parquet('data/parquet-testing/partial_field_ids_row_groups.parquet')
----
2500	2142	2000	1666	0	26764290	2500000	7.809375e+5	2024-01-01 00:00:00	2024-01-01 00:41:39	123750

query I
SELECT count() FROM read_parquet('data/parquet-testing/partial_field_ids_row_groups.parquet') WHERE f
----
1250

# The rows around the end of the first row group. QuestDB's LIMIT 2046, 2050 is DuckDB's LIMIT 4 OFFSET 2046.
query IITTTRII
SELECT * FROM read_parquet('data/parquet-testing/partial_field_ids_row_groups.parquet') LIMIT 2046, 2050
----
20460	2046	NULL	2024-01-01 00:34:06	true	511.500000	NULL	46
20470	2047	v2047	2024-01-01 00:34:07	false	511.750000	NULL	47
20480	2048	v2048	2024-01-01 00:34:08	true	512.000000	NULL	48
20490	2049	NULL	2024-01-01 00:34:09	false	512.250000	NULL	49

# The last rows. QuestDB's LIMIT -2 is the last two rows.
query IITTTRII
SELECT * FROM read_parquet('data/parquet-testing/partial_field_ids_row_groups.parquet') LIMIT -2
----
24980	2498	v2498	2024-01-01 00:41:38	true	624.500000	NULL	98
NULL	2499	NULL	2024-01-01 00:41:39	false	624.750000	NULL	99

query IIIIII
SELECT k, count(), count(a), sum(a), sum(b), count(s) FROM read_parquet('data/parquet-testing/partial_field_ids_row_groups.parquet') WHERE k IN (0, 1, 49, 99) GROUP BY k ORDER BY k
----
0	25	0	NULL	258000	16
1	25	25	30025	246210	17
49	25	25	31225	268290	17
99	25	25	32475	266790	16
